{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,route,default,template,global-error}.{ts,tsx}",
        "src/app/**/{sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
        "src/app/sw.ts",
        "next.config.ts",
        "src/proxy.ts",
        "scripts/**/*.mjs",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": ["api/**", "graphify-out/**", "node_modules/**", "**/*.d.ts"],
  "ignoreDependencies": []
}
