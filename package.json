{
  "name": "transit-sltt-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Transit SLTT - Gestion de transit, transport et logistique",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:front": "npm run dev --workspace=frontend",
    "dev:back": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:front": "npm run build --workspace=frontend",
    "build:back": "npm run build --workspace=backend",
    "test": "npm run test --workspaces",
    "test:front": "npm run test --workspace=frontend",
    "test:back": "npm run test --workspace=backend",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "transit",
    "logistique",
    "transport",
    "nextjs",
    "nestjs",
    "prisma",
    "mysql"
  ],
  "author": "Transit SLTT",
  "license": "UNLICENSED"
}
