# Database MySQL (XAMPP / WampServer / MySQL Server)
DATABASE_URL="mysql://root:@localhost:3306/transit_sltt"

# Port du serveur NestJS
PORT=3001

# JWT Secrets
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Cookies d'authentification (access/refresh/CSRF, voir auth/cookie.config.ts)
# COOKIE_SAME_SITE : à laisser NON DÉFINIE dans la quasi-totalité des cas — le
#   défaut s'adapte déjà à NODE_ENV : "lax" hors production (dev local, pas de
#   HTTPS), "none" en production (Secure forcé automatiquement ; fonctionne
#   que le rewrite proxy Next.js soit engagé ou non, front/API sur le même
#   domaine ou non). Ne poser explicitement que pour RESTREINDRE ce défaut
#   ("strict" ou "lax" en production, si front et API sont garantis same-site
#   et qu'on veut cette couche de défense en plus du CSRF double-submit déjà
#   actif dans tous les cas — voir csrf.guard.ts).
# COOKIE_DOMAIN : à ne définir QUE si front et API partagent un domaine racine
#   commun (ex. ".example.com" pour app.example.com + api.example.com) —
#   laisser vide sinon (cookie scoped à l'hôte exact de l'API).
# COOKIE_SAME_SITE=""
# COOKIE_DOMAIN=""

# Uploads locaux
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
