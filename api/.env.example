# Database MySQL (XAMPP / WampServer / MySQL Server)
DATABASE_URL="mysql://root:@localhost:3306/transit_sltt"

# Port du serveur NestJS
PORT=3001

# JWT Secrets
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Cookies d'authentification (access/refresh/CSRF, voir auth/cookie.config.ts)
# COOKIE_SAME_SITE: "lax" (défaut, sous-domaines du même domaine ou dev) |
#   "none" (front/API sur des domaines totalement distincts — Secure requis) | "strict"
# COOKIE_DOMAIN: à ne définir QUE si front et API partagent un domaine racine
#   commun (ex. ".example.com" pour app.example.com + api.example.com) —
#   laisser vide sinon (cookie scoped à l'hôte exact de l'API).
# COOKIE_SAME_SITE="lax"
# COOKIE_DOMAIN=""

# Uploads locaux
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
